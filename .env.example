# ============================================================
# docker-base — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values as needed.
#   cp .env.example .env
# .env is gitignored and will never be committed.
# ============================================================

# Name of the shared Docker bridge network.
# All downstream projects must reference the same name.
TRAEFIK_NETWORK=traefik-net

# Traefik Docker image tag.
# See https://hub.docker.com/_/traefik for available tags.
TRAEFIK_IMAGE=traefik:v3.6

# Traefik log verbosity.
# Valid values: DEBUG, INFO, WARN, ERROR
TRAEFIK_LOG_LEVEL=INFO
